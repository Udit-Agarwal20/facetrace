# FaceCheck.ID Search API Token
# Obtain from https://facecheck.id/Face-Search/API
FACECHECK_API_TOKEN=your_facecheck_api_token_here

# When true, scans 100k faces without deducting paid credits
FACECHECK_DEMO_MODE=true

# InsightFace model bundle: buffalo_sc (lightweight, fast CPU/MPS) or buffalo_l (high precision)
INSIGHTFACE_MODEL_NAME=buffalo_sc

# Local face similarity acceptance threshold (0.0 to 1.0)
# Calibrated per PRD Section 8 / 10
SIMILARITY_THRESHOLD=0.72

# Step 2: Google Cloud Vision Web Detection Configuration
# Optional: Set path to service account json; otherwise uses Application Default Credentials (ADC)
GOOGLE_APPLICATION_CREDENTIALS=
# Enable local SHA-256 caching of search queries to prevent redundant API billing
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_DIR=data/cache

# Step 3: Blockchain Evidence Registry Configuration (Base Sepolia - Chain ID: 84532)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
# Legacy / alternative alias support:
EVIDENCE_REGISTRY_ADDRESS=
PRIVATE_KEY=